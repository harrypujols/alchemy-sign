{% layout 'layouts/page' %}

<div
  data-js="alchemy"
  class="alchemy-form"
  id="alchemy-form">
  <div
    role="img"
    aria-label="Alchemy element icon"
    aria-hidden="true"
    class="icon-holder"
    data-js="include"
    data-file="./assets/img/philosophers-stone.svg"></div>
  <h1 class="huge">{{ heading }}</h1>
  <label for="input" class="birth-label">{{ label }}</label>
  <input
    required
    type="date"
    id="input"
    class="birth-input" />
  <button
    type="submit"
    class="birth-button button"
    id="submit"
    tabindex="0">
    Get Sign
  </button>
</div>
<div id="alchemy-results" class="alchemy-results hidden">
  <section id="placeholder" class="results"></section>
  <button class="reset-button button hidden" id="reset" tabindex="0">Return</button>
</div>

<template id="template">
  <article class="results-container">
    <div
      role="img"
      aria-label="Alchemy element icon"
      aria-hidden="true"
      class="icon-holder"
      data-js="include"
      data-file="./assets/img/{= data.element =}.svg"></div>
    <p class="results-date">
      The date is
      <span class="birthdate">{= data.date =}</span>
    </p>

    <h1 class="results-element huge">
      Your alchemy element is
      <span class="element {= data.element =}">{= data.element =}</span>
    </h1>
    <p class="results-planet">
      Planetarily aligned to
      <a
        href="zodiac.html#{= data.element =}"
        class="planet {= data.planet =}"
        target="_blank" tabindex="0">{= data.planet =}</a>
    </p>
  </article>
</template>
