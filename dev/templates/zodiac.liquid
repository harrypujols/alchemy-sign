{% layout 'layouts/page' %}

<hgroup>
  <h1 class="huge">{{ heading }}</h1>
  <p>{{ intro }}</p>
</hgroup>
<article class="zodiac-intro">
  <h3>{{ calc_heading }}</h3>
  <blockquote class="quote">
    {{ quote }}
  </blockquote>
  <p>
    {{ calc_text_instruction }}
  </p>
  {{ calc_example }}
  <p>
    {{ calc_text_dual }}
  </p>
  <p>
    {{ calc_text_final }}
  </p>
</article>
<article class="signs" data-js="hashopen">
  <ul>
    {% for sign in signs %}
      <details class="sign" id="{{sign.id}}">
        <summary class="sign-name">{{ sign.name }}</summary>
        <p>
          {{ sign.description }}
        </p>
      </details>
    {% endfor %}
  </ul>
</article>
<button class="button" onclick="self.close()">Close</button>